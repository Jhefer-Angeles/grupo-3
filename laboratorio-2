TIPOS_CONSULTA_VALIDOS = ["matricula", "pagos", "constancia", "plataforma", "otro"]
LONGITUD_MINIMA_CODIGO = 6
 
def mostrar_menu():
    print("\n===== SOPORTE ACADÉMICO =====")
    print("1. Registrar nueva solicitud")
    print("2. Ver solicitudes registradas")
    print("3. Ejecutar pruebas automáticas")
    print("4. Salir")
    print("==============================")
 
def validar_texto_obligatorio(texto):
    if texto is None:
        return False
    return len(texto.strip()) > 0
 
def validar_codigo_estudiante(codigo):
    if not validar_texto_obligatorio(codigo):
        return False
    return len(codigo.strip()) >= LONGITUD_MINIMA_CODIGO
 
def validar_tipo_consulta(tipo_consulta):
    if not validar_texto_obligatorio(tipo_consulta):
        return False
    return tipo_consulta.strip().lower() in TIPOS_CONSULTA_VALIDOS
  
def calcular_prioridad(tipo_consulta):
    tipo = tipo_consulta.strip().lower()
    if tipo in ("matricula", "plataforma"):
        return "Alta"
    elif tipo == "pagos":
        return "Media"
    else:
        return "Baja"
 
def registrar_solicitud(codigo, nombre, tipo_consulta, descripcion):
    if not validar_codigo_estudiante(codigo):
        print("Error: código de estudiante inválido (vacío o muy corto).")
        return None
 
    if not validar_texto_obligatorio(nombre):
        print("Error: el nombre no puede estar vacío.")
        return None
 
    if not validar_tipo_consulta(tipo_consulta):
        print("Error: tipo de consulta no reconocido.")
        return None
 
    if not validar_texto_obligatorio(descripcion):
        print("Error: la descripción no puede estar vacía.")
        return None
 
    prioridad = calcular_prioridad(tipo_consulta)
 
    solicitud = {
        "codigo": codigo.strip(),
        "nombre": nombre.strip(),
        "tipo_consulta": tipo_consulta.strip().lower(),
        "descripcion": descripcion.strip(),
        "prioridad": prioridad,
    }
    return solicitud
 
def mostrar_resumen(solicitud):
    print("\n--- Resumen de la solicitud ---")
    print(f"Código:        {solicitud['codigo']}")
    print(f"Nombre:        {solicitud['nombre']}")
    print(f"Tipo consulta: {solicitud['tipo_consulta']}")
    print(f"Descripción:   {solicitud['descripcion']}")
    print(f"Prioridad:     {solicitud['prioridad']}")
    print("-------------------------------")
 
def capturar_solicitudes_desde_teclado(cantidad):
    lista_solicitudes = []
    for i in range(cantidad):
        print(f"\n--- Registrando solicitud {i + 1} de {cantidad} ---")
        codigo = input("Código de estudiante: ")
        nombre = input("Nombre: ")
        tipo_consulta = input("Tipo de consulta (matricula/pagos/constancia/plataforma/otro): ")
        descripcion = input("Descripción breve: ")
 
        solicitud = registrar_solicitud(codigo, nombre, tipo_consulta, descripcion)
        if solicitud is not None:
            lista_solicitudes.append(solicitud)
            mostrar_resumen(solicitud)
        else:
            print("La solicitud no se registró por datos inválidos.")
 
    return lista_solicitudes
 
def ejecutar_pruebas():
    print("\n===== EJECUTANDO PRUEBAS =====")
 
    r1 = registrar_solicitud("N00550511", "JHEFER POLO ANGELES", "matricula", "Duda sobre fechas de matrícula")
    print("Caso 1 (datos válidos):", "OK" if r1 else "FALLÓ")
 
    r2 = registrar_solicitud("", "Astrid carolina Arribasplata Rojas", "pagos", "Consulta sobre pago pendiente")
    print("Caso 2 (código vacío):", "Rechazado correctamente" if r2 is None else "ERROR: debió rechazarse")
 
    r3 = registrar_solicitud("N00552400", "Angel Daniel Huaman Chilon", "reclamo", "Quiero reclamar una nota")
    print("Caso 3 (tipo incorrecto):", "Rechazado correctamente" if r3 is None else "ERROR: debió rechazarse")
 
    r4 = registrar_solicitud("N007519", "Leyner Irigoin", "plataforma", "No puede ingresar al aula virtual")
    if r4:
        print("Caso 4 (prioridad alta):", "OK" if r4["prioridad"] == "Alta" else "FALLÓ")
    else:
        print("Caso 4 (prioridad alta): FALLÓ (no se registró)")
 
    r5 = registrar_solicitud("N00549643", "Ivan Edilberto Malca Malca", "constancia", "Solicita constancia de estudios")
    if r5:
        print("Caso 5 (prioridad baja):", "OK" if r5["prioridad"] == "Baja" else "FALLÓ")
    else:
        print("Caso 5 (prioridad baja): FALLÓ (no se registró)")
 
    print("===== FIN DE PRUEBAS =====")
 
def main():
    lista_solicitudes = []
 
    while True:
        mostrar_menu()
        opcion = input("Seleccione una opción: ")
 
        if opcion == "1":
            nuevas = capturar_solicitudes_desde_teclado(3)
            lista_solicitudes.extend(nuevas)
 
        elif opcion == "2":
            if not lista_solicitudes:
                print("\nAún no hay solicitudes registradas.")
            else:
                for solicitud in lista_solicitudes:
                    mostrar_resumen(solicitud)
 
        elif opcion == "3":
            ejecutar_pruebas()
 
        elif opcion == "4":
            print("Saliendo del sistema...")
            break
 
        else:
            print("Opción no válida, intente de nuevo.")
 
if __name__ == "__main__":
    main()
