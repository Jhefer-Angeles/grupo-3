Algoritmo MesaDePartesCajacha
	Definir opcion, total_pedidos, estilo, litros Como Entero;
	Definir codigo, cliente, ruc, fecha Como Cadena;
	// Inicialización del contador de registros
	total_pedidos <- 0;
	Escribir "Cargando pedidos desde pedidos.txt...";
	Repetir // Estructura repetitiva principal (Bucle)
		// Entrada y salida de datos (Menú de opciones)
		Escribir "=== MESA DE PARTES DIGITAL - CAJACHA ===";
		Escribir "1. Registrar | 2. Consultar | 3. Ordenar | 4. Listar | 5. Salir";
		Escribir "Seleccione opcion (1-5):";
		Leer opcion;
		
		Si opcion >= 1 Y opcion <= 5 Entonces
			Segun opcion Hacer 
				1: 
					Escribir "Ingrese cliente, RUC, estilo, litros y fecha de entrega:";
					Leer cliente, ruc, estilo, litros, fecha;
					total_pedidos <- total_pedidos + 1; // Incremento del contador
					Escribir "Pedido registrado y guardado.";
				2: 
					Escribir "Ingrese codigo a buscar:";
					Leer codigo;
					Escribir "Ejecutando busqueda por codigo...";
				3: 
					Escribir "Ordenando por codigo (burbuja)...";
					Escribir "Pedidos ordenados por codigo.";
				4: 
					Escribir "Mostrar pedidos registrados.";
				5: 
					Escribir "Guardando pedidos en pedidos.txt...";
					Escribir "Saliendo del sistema. Hasta pronto.";
			FinSegun
		Sino
			
			Escribir "Opcion no valida. Ingrese un numero del 1 al 5.";
		FinSi
		
	Hasta Que opcion = 5
FinAlgoritmo
