// ===== FUNCIONES =====
Funcion r <- es_numero_entero_positivo(texto)
	// Verdadero si el texto no está vacío y todos sus caracteres son dígitos
	Definir r, encontrado Como Logico
	Definir i, j Como Entero
	r <- Longitud(texto) > 0
	Para i <- 1 Hasta Longitud(texto) Con Paso 1 Hacer
		encontrado <- Falso
		Para j <- 1 Hasta 10 Con Paso 1 Hacer
			Si Subcadena(texto, i, i) = Subcadena("0123456789", j, j) Entonces
				encontrado <- Verdadero
			FinSi
		FinPara
		Si No encontrado Entonces
			r <- Falso
		FinSi
	FinPara
FinFuncion

Funcion r <- es_ruc_valido(ruc)
	// Validación básica: exactamente 11 dígitos.
	// No verifica el dígito de control del RUC.
	Definir r Como Logico
	r <- Falso
	Si Longitud(ruc) = 11 Entonces
		r <- es_numero_entero_positivo(ruc)
	FinSi
FinFuncion

Funcion r <- es_litros_valido(texto)
	Definir r Como Logico
	r <- Falso
	Si es_numero_entero_positivo(texto) Entonces
		Si ConvertirANumero(texto) > 0 Entonces
			r <- Verdadero
		FinSi
	FinSi
FinFuncion

Funcion r <- es_fecha_valida(fecha)
	// Validación básica: DD/MM/AAAA.
	// Admite días del 1 al 31; no distingue la duración de cada mes.
	Definir r Como Logico
	Definir texto_dia, texto_mes, texto_anio Como Caracter
	Definir dia, mes, anio Como Entero
	r <- Falso
	Si Longitud(fecha) = 10 Entonces
		Si Subcadena(fecha, 3, 3) = "/" Y Subcadena(fecha, 6, 6) = "/" Entonces
			texto_dia <- Subcadena(fecha, 1, 2)
			texto_mes <- Subcadena(fecha, 4, 5)
			texto_anio <- Subcadena(fecha, 7, 10)
			Si es_numero_entero_positivo(texto_dia) Y es_numero_entero_positivo(texto_mes) Y es_numero_entero_positivo(texto_anio) Entonces
				dia <- ConvertirANumero(texto_dia)
				mes <- ConvertirANumero(texto_mes)
				anio <- ConvertirANumero(texto_anio)
				r <- (dia >= 1 Y dia <= 31) Y (mes >= 1 Y mes <= 12) Y anio >= 1
			FinSi
		FinSi
	FinSi
FinFuncion

// ===== PROGRAMA PRINCIPAL =====

Algoritmo mesa_de_partes_cajacha
	Definir total, opcion, i, j, pos, num_estilo, litros, aux_num Como Entero
	Definir codigos, clientes, rucs, fechas Como Caracter
	Definir estilos, cantidades Como Entero
	Definir opcion_txt, estilo_txt, litros_txt, cliente, ruc, fecha, buscado, codigo, aux_txt Como Caracter
	Definir datos_validos, salir, opcion_ok Como Logico
	
	Dimension codigos[100]
	Dimension clientes[100]
	Dimension rucs[100]
	Dimension estilos[100]
	Dimension cantidades[100]
	Dimension fechas[100]
	
	total <- 0
	salir <- Falso
	
	Para i <- 1 Hasta 100 Con Paso 1 Hacer
		codigos[i] <- ""
		clientes[i] <- ""
		rucs[i] <- ""
		estilos[i] <- 0
		cantidades[i] <- 0
		fechas[i] <- ""
	FinPara
	
	Escribir "Cargando pedidos desde pedidos.txt..."
	
	Repetir
		Escribir ""
		Escribir "=== MESA DE PARTES DIGITAL - CAJACHA ==="
		Escribir "1. Registrar | 2. Consultar | 3. Ordenar | 4. Listar | 5. Salir"
		Escribir Sin Saltar "Seleccione opcion (1-5): "
		Leer opcion_txt
		
		opcion_ok <- Falso
		Si es_numero_entero_positivo(opcion_txt) Entonces
			opc <- ConvertirANumero(opcion_txt)
			Si opc >= 1 Y opc <= 5 Entonces
				opcion_ok <- Verdadero
			FinSi
		FinSi
		
		Si No opcion_ok Entonces
			Escribir "Opcion no valida. Ingrese un numero del 1 al 5."
		Sino
			Segun opcion Hacer
				
				1:
					Escribir "Ingrese cliente, RUC, estilo, litros y fecha de entrega:"
					
					Escribir Sin Saltar "Cliente: "
					Leer cliente
					Escribir Sin Saltar "RUC: "
					Leer ruc
					
					Escribir Sin Saltar "Estilo (1-5): "
					Leer estilo_txt
					Si es_numero_entero_positivo(estilo_txt) Entonces
						num_estilo <- ConvertirANumero(estilo_txt)
					Sino
						num_estilo <- 0
					FinSi
					
					Escribir Sin Saltar "Litros: "
					Leer litros_txt
					Escribir Sin Saltar "Fecha de entrega (DD/MM/AAAA): "
					Leer fecha
					
					datos_validos <- Falso
					Si cliente <> "" Y es_ruc_valido(ruc) Y (num_estilo >= 1 Y num_estilo <= 5) Y es_litros_valido(litros_txt) Y es_fecha_valida(fecha) Entonces
						datos_validos <- Verdadero
					FinSi
					
					Si datos_validos Entonces
						Si total < 100 Entonces
							litros <- ConvertirANumero(litros_txt)
							
							aux_num <- total + 1
							aux_txt <- ConvertirATexto(aux_num)
							Si aux_num < 10 Entonces
								codigo <- "PED-00" + aux_txt
							Sino
								Si aux_num < 100 Entonces
									codigo <- "PED-0" + aux_txt
								Sino
									codigo <- "PED-" + aux_txt
								FinSi
							FinSi
							
							codigos[total + 1] <- codigo
							clientes[total + 1] <- cliente
							rucs[total + 1] <- ruc
							estilos[total + 1] <- num_estilo
							cantidades[total + 1] <- litros
							fechas[total + 1] <- fecha
							
							total <- total + 1
							
							Escribir "Pedido registrado y guardado."
							Escribir "Codigo: ", codigo
						Sino
							Escribir "No se pueden registrar mas de 100 pedidos."
						FinSi
					Sino
						Escribir "Error: datos invalidos."
					FinSi
					
				2:
					Escribir Sin Saltar "Ingrese codigo a buscar: "
					Leer buscado
					buscado <- Mayusculas(buscado)
					pos <- -1
					
					Para i <- 1 Hasta total Con Paso 1 Hacer
						Si codigos[i] = buscado Entonces
							pos <- i
						FinSi
					FinPara
					
					Si pos = -1 Entonces
						Escribir "Pedido no encontrado."
					Sino
						Escribir "Codigo: ", codigos[pos]
						Escribir "Cliente: ", clientes[pos]
						Escribir "RUC: ", rucs[pos]
						Escribir "Estilo: ", estilos[pos]
						Escribir "Litros: ", cantidades[pos]
						Escribir "Fecha: ", fechas[pos]
					FinSi
					
				3:
					Escribir "Ordenando por codigo (burbuja)..."
					
					Para i <- 1 Hasta total - 1 Con Paso 1 Hacer
						Para j <- 1 Hasta total - i Con Paso 1 Hacer
							Si codigos[j] > codigos[j + 1] Entonces
								aux_txt <- codigos[j]
								codigos[j] <- codigos[j + 1]
								codigos[j + 1] <- aux_txt
								
								aux_txt <- clientes[j]
								clientes[j] <- clientes[j + 1]
								clientes[j + 1] <- aux_txt
								
								aux_txt <- rucs[j]
								rucs[j] <- rucs[j + 1]
								rucs[j + 1] <- aux_txt
								
								aux_num <- estilos[j]
								estilos[j] <- estilos[j + 1]
								estilos[j + 1] <- aux_num
								
								aux_num <- cantidades[j]
								cantidades[j] <- cantidades[j + 1]
								cantidades[j + 1] <- aux_num
								
								aux_txt <- fechas[j]
								fechas[j] <- fechas[j + 1]
								fechas[j + 1] <- aux_txt
							FinSi
						FinPara
					FinPara
					
					Escribir "Pedidos ordenados por codigo."
					
				4:
					Si total = 0 Entonces
						Escribir "No hay pedidos registrados."
					Sino
						Para i <- 1 Hasta total Con Paso 1 Hacer
							Escribir codigos[i], " | ", clientes[i], " | RUC: ", rucs[i], " | Estilo: ", estilos[i], " | Litros: ", cantidades[i], " | Fecha: ", fechas[i]
						FinPara
						
						Escribir "Mostrar pedidos registrados."
					FinSi
					
				5:
					Escribir "Guardando pedidos en pedidos.txt..."
					Escribir "Saliendo del sistema. Hasta pronto."
					salir <- Verdadero
					
			FinSegun
		FinSi
	Hasta Que salir
FinAlgoritmo
